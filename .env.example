# Discord user token (DO NOT share this with anyone)
DISCORD_TOKEN=YOUR_DISCORD_TOKEN_HERE

# Numeric ID of the server (guild) that contains the voice channel
GUILD_ID=YOUR_GUILD_ID_HERE

# Numeric ID of the voice channel to join
CHANNEL_ID=YOUR_CHANNEL_ID_HERE

# Presence status: online | idle | dnd
STATUS=online

# Whether to join the channel muted
SELF_MUTE=true

# Whether to join the channel deafened
SELF_DEAF=false

# HTTP health endpoint port (exposed by the container, probed by Docker HEALTHCHECK)
HEALTH_PORT=8080
# Host interface the health server binds to. Use 0.0.0.0 inside the container.
HEALTH_HOST=0.0.0.0
# Mark the container unhealthy if no gateway heartbeat was seen within N seconds
HEALTH_STALE_AFTER=60
